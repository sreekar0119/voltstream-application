APP_NAME=VoltStream API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
VERTEX_AI_PROJECT=your-google-cloud-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-1.5-flash
GOOGLE_APPLICATION_CREDENTIALS=secrets/vertex-service-account.json
EMBEDDING_MODEL=all-MiniLM-L6-v2

DATABASE_URL=voltstream.db
DOCUMENTS_DIR=documents
CHROMA_DB_DIR=chroma_db
RAG_COLLECTION_NAME=voltstream_documents
RAG_TOP_K=4
RAG_CHUNK_TOKENS=420
RAG_CHUNK_OVERLAP=60
